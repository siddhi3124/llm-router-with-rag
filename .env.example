# ===== LLM Provider =====
# Options: gemini / openai / other
PROVIDER=gemini

# ===== API Keys =====
# Replace with your own API key
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Model Settings =====
# Chat model used for responses
CHAT_MODEL=gemini-3-flash-preview

# Embedding model used for vector search
EMBED_MODEL=gemini-embedding-001

# ===== Feature Flags =====
# Enable evaluation metrics (1 = on, 0 = off)
ENABLE_EVAL=1

# Enable multi-step research planning
ENABLE_RESEARCH_PLAN=0

# ===== Embedding Provider =====
# Options: local / gemini / openai
EMBED_PROVIDER=local

# Local embedding model
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2